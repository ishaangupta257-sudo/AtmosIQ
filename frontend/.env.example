# AtmosIQ frontend — environment variables (Vite).
#
# SINGLE SOURCE OF TRUTH for the API base URL. It must point at the Node/Express
# backend, which fronts the FastAPI ML engine. Include the trailing "/api".
#
# Local dev (Express running on your machine):
#   VITE_API_BASE=http://localhost:5000/api
#
# Production (Express deployed on Render — set this in .env.production AND/OR in
# Netlify → Site settings → Environment variables; a Netlify-set value wins):
#   VITE_API_BASE=https://<your-express-service>.onrender.com/api
#
# NOTE: this must be the EXPRESS backend, NOT the FastAPI ML engine
# (https://atmosiq-1-y8f8.onrender.com). The ML engine uses different paths
# (/locations, /current/{id}) and lacks /route-suitability, /assistant, etc.
VITE_API_BASE=http://localhost:5000/api
