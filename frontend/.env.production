# Production build config (Vite reads this automatically on `vite build`).
#
# VITE_API_BASE is the SINGLE source of truth for the backend URL. The client
# auto-detects the backend flavor from it:
#   • URL WITHOUT a trailing /api  -> your FastAPI ML engine, called directly
#   • URL WITH a trailing /api     -> a Node/Express backend in front of it
#
# Your deployed backend is the FastAPI ML engine, so use its URL with NO /api:
VITE_API_BASE=https://atmosiq-1-y8f8.onrender.com
#
# IMPORTANT: A value set in Netlify → Site settings → Environment variables
# (PRODUCTION context) OVERRIDES this file at build time. Make sure Netlify's
# Production value is this same public URL — NOT localhost or a 192.168.x.x LAN
# address (that only works on your own device and is why other visitors get no
# data). After changing it, trigger a fresh production deploy — saving the env
# var alone does not rebuild.
