# AtmosIQ backend configuration (copy to .env — all optional with safe defaults)

PORT=5000

# Python ML engine (FastAPI) this backend proxies.
#   Local:      cd ml-engine && python3 -m uvicorn serve:app --port 8000
#   Production: set this to your deployed FastAPI URL, e.g.
#               ML_ENGINE_URL=https://atmosiq-1-y8f8.onrender.com
ML_ENGINE_URL=http://127.0.0.1:8000

# CORS allow-list for the browser frontend. Leave unset to allow all origins
# (prototype default), or set to your exact Netlify site URL(s), comma-separated:
#   CORS_ORIGIN=https://clever-jalebi-23f6e8.netlify.app
# CORS_ORIGIN=

# MongoDB. If unreachable the backend falls back to an in-memory store, so the
# demo runs with no database installed. Point this at a real cluster for prod.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=atmosiq

# Cache TTL for ML responses (seconds)
CACHE_TTL=300

# Scheduled pipeline runs. "cron" = run every RUN_INTERVAL_MIN minutes;
# "ondemand" = only via POST /api/pipeline/run. See README.
PIPELINE_MODE=ondemand
RUN_INTERVAL_MIN=30
