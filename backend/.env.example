# AtmosIQ backend configuration (copy to .env — all optional with safe defaults)

PORT=5000

# Python ML engine (FastAPI). Start it with:
#   cd ml-engine && python3 -m uvicorn serve:app --port 8000
ML_ENGINE_URL=http://127.0.0.1:8000

# MongoDB. If unreachable the backend falls back to an in-memory store, so the
# demo runs with no database installed. Point this at a real cluster for prod.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=atmosiq

# Cache TTL for ML responses (seconds)
CACHE_TTL=300

# Scheduled pipeline runs. "cron" = run every RUN_INTERVAL_MIN minutes;
# "ondemand" = only via POST /api/pipeline/run. See README.
PIPELINE_MODE=ondemand
RUN_INTERVAL_MIN=30
